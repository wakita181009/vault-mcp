{
	"name": "vault-mcp",
	"version": "0.6.2",
	"type": "module",
	"description": "Authenticated remote MCP server on Cloudflare Workers that exposes a private Obsidian vault (GitHub repo, Cloudflare R2, or any S3-compatible bucket) to claude.ai and Claude Code: read, create/overwrite, and delete notes, never rename or move.",
	"license": "MIT",
	"packageManager": "pnpm@12.23.0",
	"scripts": {
		"build": "vite build",
		"deploy": "vite build && wrangler deploy",
		"dev": "vite dev",
		"start": "vite dev",
		"preview": "vite build && vite preview",
		"cf-typegen": "wrangler types --strict-vars false --env-file /dev/null",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"typecheck": "wrangler types --strict-vars false --env-file /dev/null --check && tsc --noEmit",
		"prepare": "husky || true"
	},
	"dependencies": {
		"@cloudflare/workers-oauth-provider": "^1.2.4",
		"@modelcontextprotocol/client": "2.3.1",
		"@modelcontextprotocol/sdk": "1.32.1",
		"@modelcontextprotocol/server": "2.3.1",
		"agents": "^0.30.1",
		"aws4fetch": "1.0.20",
		"hono": "^4.13.19",
		"octokit": "^5.0.5",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.8",
		"@cloudflare/vite-plugin": "^1.70.1",
		"@vitest/coverage-v8": "4.1.10",
		"husky": "^9.1.7",
		"typescript": "7.0.2",
		"vite": "^8.3.8",
		"vitest": "^4.1.10",
		"wrangler": "^4.165.0",
		"zod-aot": "^0.21.7"
	}
}
