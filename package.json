{
	"name": "vault-mcp",
	"version": "0.1.0",
	"description": "Authenticated remote MCP server on Cloudflare Workers that exposes a private GitHub-hosted Obsidian vault (read and create/overwrite notes, never deletes) to claude.ai and Claude Code.",
	"license": "MIT",
	"packageManager": "pnpm@11.14.0",
	"scripts": {
		"deploy": "wrangler deploy",
		"dev": "wrangler dev",
		"start": "wrangler dev",
		"cf-typegen": "wrangler types --strict-vars false",
		"lint": "biome lint ./src",
		"lint:fix": "biome lint --write ./src",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"typecheck": "wrangler types --strict-vars false --check && tsc --noEmit",
		"prepare": "husky || true"
	},
	"dependencies": {
		"@cloudflare/workers-oauth-provider": "^0.10.3",
		"@modelcontextprotocol/sdk": "^1.29.0",
		"agents": "^0.17.4",
		"hono": "^4.13.2",
		"octokit": "^5.0.5",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.8",
		"@vitest/coverage-v8": "4.1.10",
		"husky": "^9.1.7",
		"typescript": "7.0.2",
		"vitest": "^4.1.10",
		"wrangler": "^4.123.0"
	}
}
