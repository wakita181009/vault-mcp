/**
 * Sample Worker config. Copy to `wrangler.jsonc` and fill in your own values:
 *
 *   cp wrangler.jsonc.example wrangler.jsonc
 *
 * `wrangler.jsonc` is gitignored so your real owner/repo/allowlist never land in git.
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vault-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2025-03-10",
  "compatibility_flags": ["nodejs_compat"],
  /**
   * Secrets are NOT stored here. Set them with `wrangler secret put`:
   *   pnpm exec wrangler secret put GITHUB_CLIENT_ID      # OAuth app (who may log in)
   *   pnpm exec wrangler secret put GITHUB_CLIENT_SECRET  # OAuth app
   *   pnpm exec wrangler secret put COOKIE_ENCRYPTION_KEY # `openssl rand -hex 32`
   *   pnpm exec wrangler secret put VAULT_GITHUB_TOKEN    # read-only fine-grained PAT for reading the vault
   *
   * For local dev, put the same keys in `.dev.vars` (see .dev.vars.example).
   */
  "migrations": [
    {
      "new_sqlite_classes": ["VaultMCP"],
      "tag": "v1"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "VaultMCP",
        "name": "MCP_OBJECT"
      }
    ]
  },
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "<Add-KV-ID>"
    }
  ],
  /**
   * Non-secret configuration. Override per environment as needed.
   * - VAULT_OWNER / VAULT_REPO / VAULT_BRANCH: the private repo the vault lives in.
   * - ALLOWED_GITHUB_LOGINS: comma-separated GitHub logins allowed to use the MCP at all.
   * - VAULT_ALLOWED_PREFIXES: comma-separated path prefixes to expose (empty = whole repo).
   * - VAULT_DENIED_PREFIXES: comma-separated path prefixes to always hide.
   */
  "vars": {
    "VAULT_OWNER": "your-github-login",
    "VAULT_REPO": "your-vault-repo",
    "VAULT_BRANCH": "main",
    "ALLOWED_GITHUB_LOGINS": "your-github-login",
    "VAULT_ALLOWED_PREFIXES": "",
    "VAULT_DENIED_PREFIXES": ".git/,.obsidian/,.claude/,claude-projects/"
  },
  "observability": {
    "enabled": true
  },
  "dev": {
    "port": 8788
  }
}
